    "restore": "tsx --env-file-if-exists=.env.local scripts/restore.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
