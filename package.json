{
  "name": "lift-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "tsx scripts/check.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
